# ============================================================================
# TCER 环境变量配置模板
# ----------------------------------------------------------------------------
# 复制为 .env 使用。真实 .env 已被 .gitignore 忽略，不会进库。
# .env 读取位置：发布版=exe 同目录；源码运行=当前工作目录 / 仓库根。
# 优先级：真实环境变量 > .env 文件。
# ============================================================================

# ----------------------------------------------------------------------------
# 客户端（桌面 GUI）上传配置 —— TCER_CLIENT_UPLOAD_*
# 仅上传功能需要；不配则 GUI 保持纯离线，右上角「上传…」按钮隐藏。
# ----------------------------------------------------------------------------

# 上传目标服务器地址。配置了才显示「上传…」按钮；留空 = 隐藏（默认）。
# 例：http://127.0.0.1:8890 或 https://tcer.example.com
TCER_CLIENT_UPLOAD_URL=

# 上传认证用的 API Token（在 Web 端「API Token」页生成，形如 tcer_xxxxx）。
# 配置后上传按该 Token 所属用户归账；留空 = 匿名上传。
TCER_CLIENT_UPLOAD_AUTH_TOKEN=

# 是否附带逐会话明细（完整对话内容）。true/1/yes/on 为开；留空/其他 = false（仅上传指标）。
TCER_CLIENT_UPLOAD_DETAIL=false

# ----------------------------------------------------------------------------
# 服务端（TCER Server）配置 —— TCER_SERVER_*
# 仅部署服务端时需要；桌面客户端用户无需配置。
# ----------------------------------------------------------------------------

# 监听地址与端口（默认 127.0.0.1:8890）。
TCER_SERVER_HOST=127.0.0.1
TCER_SERVER_PORT=8890

# 登录 Token 的 HMAC 签名密钥。不设则每次重启随机生成（重启后旧登录 Token 失效；
# 生产环境建议固定一个长随机串，避免用户频繁掉登录）。API Token 存哈希入库，不受此影响。
TCER_SERVER_SECRET=

# SQLite 数据库路径（默认 server/backend/tcer_server.db）。
TCER_SERVER_DB=