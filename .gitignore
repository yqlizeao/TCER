# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Test / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Packaging / build artifacts (PyInstaller 本地产物;CI 产物走 Release 不入库)
*.egg-info/
build/
dist/
.eggs/
*.spec

# Virtual environments
venv/
.venv/
env/

# Editor / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local env config — now server-only (TCER_SERVER_*). Client upload config
# lives in tcer_ui.json 的 upload 段. Never commit real .env.
.env
.env.*

# Local server runtime data (root-level deploy layout: SQLite DB + logs).
# server/.gitignore covers server/*.db|*.log; these mirror it for repo root.
data/
logs/
*.db
*.db-wal
*.db-shm
*.log

# TCER report exports
*.csv
